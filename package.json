{
  "name": "xao-ethdenver-nft",
  "version": "1.0.0",
  "description": "XAO ETHDenver NFT Collection - Free, culturally expressive NFTs on Base",
  "main": "contracts/XAOETHDenverNFT_ERC721A.sol",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "test:grep": "hardhat test --grep",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network baseSepolia",
    "deploy:base": "hardhat run scripts/deploy.js --network base",
    "mint:set-window": "hardhat run scripts/setMintWindow.js --network base",
    "mint:set-window:sepolia": "hardhat run scripts/setMintWindow.js --network baseSepolia",
    "mint:test": "hardhat run scripts/testMint.js --network base",
    "status": "hardhat run scripts/status.js --network base",
    "status:sepolia": "hardhat run scripts/status.js --network baseSepolia",
    "mint:close": "hardhat run scripts/closeMint.js --network base",
    "metadata:freeze": "hardhat run scripts/freezeMetadata.js --network base",
    "verify": "hardhat verify --network base",
    "clean": "hardhat clean",
    "help": "hardhat help"
  },
  "keywords": [
    "nft",
    "ethereum",
    "base",
    "erc721",
    "erc721a",
    "smart-contract",
    "solidity",
    "ethdenver",
    "xao"
  ],
  "author": "XAO Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
